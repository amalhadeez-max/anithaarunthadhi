# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME=Anithaarunthadhi

# ─── Supabase (Project Settings → API) ────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon...
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...      # server only, never exposed
SUPABASE_STORAGE_BUCKET=media

# ─── Database (Project Settings → Database → Connection string) ───────────────
# Pooled (transaction mode, port 6543) for the app at runtime:
DATABASE_URL="postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct (session mode, port 5432) for Prisma migrations:
DIRECT_URL="postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ─── Google OAuth (Google Cloud Console → Credentials) ────────────────────────
# These are configured inside Supabase Dashboard → Authentication → Providers → Google.
# Kept here for documentation / local reference only.
GOOGLE_OAUTH_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxxxxxx

# ─── Razorpay (Dashboard → Settings → API Keys, use TEST mode keys) ───────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxx

# ─── WhatsApp (used for the floating button / "Ask on WhatsApp") ──────────────
# Digits only, with country code. Can be overridden from Admin → Site Settings.
NEXT_PUBLIC_WHATSAPP_NUMBER=918608612481

# ─── Email (optional — Resend free tier). If unset, emails are logged to console.
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM="Anithaarunthadhi <orders@yourdomain.com>"
ADMIN_NOTIFICATION_EMAIL=owner@example.com

# ─── Seed users (used only by `pnpm db:seed`) ─────────────────────────────────
SEED_ADMIN_EMAIL=admin@anithaarunthadhi.test
SEED_ADMIN_PASSWORD=Admin@12345
SEED_CUSTOMER_EMAIL=customer@anithaarunthadhi.test
SEED_CUSTOMER_PASSWORD=Customer@12345
